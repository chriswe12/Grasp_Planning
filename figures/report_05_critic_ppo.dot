digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.15, nodesep=0.28, ranksep=0.5,
         fontname="Helvetica", fontsize=18, label="Asymmetric Critic and Hybrid PPO Update", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
        color="#34495e", fillcolor="white", margin="0.12,0.07"];
  edge [color="#34495e", penwidth=1.15, arrowsize=0.65, fontname="Helvetica", fontsize=8];

  state [label="Privileged critic state [B,26]\nq [7] + qdot [7] + world position error [3]\n+ rotation error [3] + previous motion action [6]", fillcolor="#ddf3ef"];
  critic [label="CENTRALIZED CRITIC\nMLP 26->256->128->64->1\nELU hidden activations", fillcolor="#ddf3ef"];
  value [label="V(s) [B,1]", fillcolor="#ddf3ef"];
  returns [label="GAE returns and advantages\ngamma=0.99, lambda=0.95", fillcolor="#fff7e8"];
  old [label="Stored rollout\naction + old log probability\nold Gaussian/Bernoulli parameters", fillcolor="#eaf3fb"];
  actor [label="Re-evaluate current actor\nGaussian motion + Bernoulli stop", fillcolor="#eee8fa"];
  policy [label="Clipped PPO policy loss\nepsilon=0.1", fillcolor="#fff1d6"];
  kl [label="Hybrid KL\nGaussian KL + Bernoulli KL\ncontrols LR schedule", fillcolor="#fff1d6"];
  aux [label="Add pose + completion\nauxiliary losses", fillcolor="#fff7e8"];
  update [label="Backpropagate summed loss\n2 mini-epochs, minibatch 1024\nlearning rate 5e-5, grad norm <= 0.5", fillcolor="#fff0f0"];
  note [label="No critic feature or V(s) is fed into actor heads.\nCoupling is only through advantage/return computation.", fillcolor="#f4fbfa", penwidth=1.6, color="#19857b"];

  state -> critic -> value -> returns;
  old -> returns [label="rewards"];
  old -> actor;
  actor -> policy;
  returns -> policy [label="advantage"];
  actor -> kl; old -> kl;
  policy -> aux -> update;
  kl -> update [style=dashed, label="schedule diagnostic"];
  value -> note [style=dotted, color="#19857b"];
}
