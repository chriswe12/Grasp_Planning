# Copy this file to euler/euler.env and fill in the site-specific values.
EULER_LOGIN=your-euler-login
EULER_ACCOUNT=your-slurm-account
EULER_PROJECT_DIR=/cluster/home/your-user/grasping_rl

EULER_IMAGE_PATH=/cluster/scratch/your-user/isaaclab-containers/isaac-lab-2.3.2.sif
EULER_CACHE_DIR=/cluster/scratch/your-user/docker-isaac-sim
EULER_RUNS_DIR=/cluster/scratch/your-user/grasping-rl-runs
EULER_TRAIN_TIME_LIMIT=2-00:00:00

EULER_GPU_TYPE=rtx_4090
EULER_GPU_COUNT=1
EULER_GPUMEM=20G
EULER_CPUS_PER_GPU=8
EULER_MEM_PER_CPU=3G

EULER_DOCKER_IMAGE=isaac-lab-euler:2.3.2
EULER_LOCAL_IMAGE=.cache/euler/isaac-lab-2.3.2.sif
EULER_LOCAL_TORCH_CACHE=.cache/euler/torch
EULER_RESNET18_URL=https://download.pytorch.org/models/resnet18-f37072fd.pth
EULER_RESNET18_FILE=resnet18-f37072fd.pth
EULER_RESNET18_SHA256_PREFIX=f37072fd

# Keep the outer project first so grasp_planning and the pinned isaac_rl
# checkout resolve consistently inside the container.
EULER_CONTAINER_PYTHONPATH=/workspace/grasping_rl:/workspace/grasping_rl/isaac_rl/source/isaac_rl:/workspace/isaaclab/source/isaaclab:/workspace/isaaclab/source/isaaclab_assets:/workspace/isaaclab/source/isaaclab_contrib:/workspace/isaaclab/source/isaaclab_mimic:/workspace/isaaclab/source/isaaclab_rl:/workspace/isaaclab/source/isaaclab_tasks
