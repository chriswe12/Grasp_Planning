<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pdz_gripper">
  <xacro:include filename="$(find pdz_gripper_description)/urdf/pdz_gripper_macro.xacro"/>
  <xacro:arg name="use_pads" default="true"/>
  <xacro:arg name="pad_thickness" default="0.008"/>
  <xacro:arg name="use_camera" default="true"/>
  <xacro:arg name="camera_use_nominal_extrinsics" default="true"/>

  <link name="world"/>
  <xacro:pdz_gripper
    parent="world"
    prefix=""
    use_pads="$(arg use_pads)"
    pad_thickness="$(arg pad_thickness)"
    use_camera="$(arg use_camera)"
    camera_use_nominal_extrinsics="$(arg camera_use_nominal_extrinsics)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:pdz_gripper>
</robot>
