#usda 1.0
(
    defaultPrim = "TSlotSurface"
    metersPerUnit = 1
    upAxis = "Z"
)

# Render/depth geometry only. The task's invisible /World/GroundPlane remains
# the sole workspace collision surface at z=0.
def Xform "TSlotSurface"
{
    def Scope "Looks"
    {
        def Material "Aluminum"
        {
            token outputs:surface.connect = </TSlotSurface/Looks/Aluminum/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.61, 0.64)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Slot"
        {
            token outputs:surface.connect = </TSlotSurface/Looks/Slot/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.065, 0.075)
                float inputs:metallic = 0.55
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }
    }

    def Cube "SlotBacking" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </TSlotSurface/Looks/Slot>
        double3 xformOp:scale = (0.65, 0.60, 0.004)
        double3 xformOp:translate = (0, 0, -0.009)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Lands"
    {
        def Cube "Land_00" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </TSlotSurface/Looks/Aluminum>
            double3 xformOp:scale = (0.0205, 0.60, 0.003)
            double3 xformOp:translate = (-0.306, 0, -0.003)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
